APP_NAME=ValueMap
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://valuemap-project.eu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=valuemap_CHANGE_ME
DB_USERNAME=valuemap_CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
PUBLIC_STORAGE_PATH=/home/valuemap/public_html/storage
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@valuemap-project.eu"
MAIL_FROM_NAME="${APP_NAME}"

GA_MEASUREMENT_ID=
GEMINI_API_KEY=
GEMINI_NEWS_MODEL=gemini-3.5-flash-lite

VITE_APP_NAME="${APP_NAME}"
