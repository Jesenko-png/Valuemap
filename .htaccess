<IfModule mod_rewrite.c>
    RewriteEngine On

    # InfinityFree does not support Laravel's public/storage symlink.
    RewriteRule ^storage/(.*)$ /storage/app/public/$1 [END]

    # InfinityFree fixes htdocs as the web root, so route all traffic through public/.
    RewriteRule (.*) /public/$1 [L]
</IfModule>
